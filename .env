# The distributor API. Matches the http launch profile in
# Greenplus.Distributor.Api/Properties/launchSettings.json.
#
# Use the http port, not https: the https profile serves 7001 with a dev certificate the browser
# will reject on a fetch, and UseHttpsRedirection then bounces http calls to it.
REACT_APP_API_URL=http://localhost:5104

# The accounting frontend already owns 3000, so this one gets its own port. Without this the dev
# server just prints "Something is already running on port 3000" and exits.
PORT=3100
